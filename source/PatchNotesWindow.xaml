<Window x:Class="Rewind.PatchNotesWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FLICK Patch Notes" Width="600" Height="620" MinWidth="360" MinHeight="320"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}"
        FontFamily="/FLICK;component/Assets/Fonts/#Inter" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="5" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FLICK;component/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style TargetType="Expander">
        <Setter Property="Margin" Value="0,7,0,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Expander">
              <StackPanel>
                <ToggleButton x:Name="NoteToggle" Content="{TemplateBinding Header}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              HorizontalAlignment="Left" Padding="1,5,6,5"
                              Foreground="{DynamicResource ThemeMuted}" Background="Transparent" BorderThickness="0">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                          <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Width="5" Height="9" Stretch="Uniform"
                                Stroke="{DynamicResource ThemeAccent}" StrokeThickness="1.6"
                                RenderTransformOrigin=".5,.5" Margin="0,0,7,0" />
                          <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource ThemeText}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="Details" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Border Background="Transparent" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NotesScrollbar" TargetType="ScrollBar">
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Border Width="4" CornerRadius="2" Background="{DynamicResource ThemeLine}" />
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb MinHeight="28">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="6" CornerRadius="3"
                                    Background="{DynamicResource ThemeAccent}" />
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Grip" Property="Width" Value="8" />
                              <Setter TargetName="Grip" Property="Background" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="Grip" Property="Background" Value="{DynamicResource ThemeAccent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="NotesScroll" TargetType="ScrollViewer">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                  Content="{TemplateBinding Content}" Margin="0,0,12,0" />
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                     Style="{StaticResource NotesScrollbar}" Minimum="0"
                     Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                     Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
        </Grid>
      </ControlTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" CornerRadius="12"
          Background="{DynamicResource ThemeSurface}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="66" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,0,0,1" Padding="20,0,12,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="M14,1 L3,13 L10,13 L6,23 L21,8 L13,8 Z" Width="17" Height="21"
                  Stretch="Uniform" Fill="{DynamicResource ThemeAccent}" Margin="0,0,8,0" />
            <TextBlock Text="FLICK" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="Patch Notes" FontSize="12" Foreground="{DynamicResource ThemeMuted}"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="34" Padding="8"
                  Background="Transparent" BorderThickness="0" ToolTip="Close patch notes"
                  AutomationProperties.Name="Close patch notes" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="CloseNotes">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.6" />
          </Button>
        </Grid>
      </Border>
      <ScrollViewer x:Name="NotesBody" Grid.Row="1" Margin="24,12,15,12" Template="{StaticResource NotesScroll}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="True" AutomationProperties.Name="Patch notes" />
      <Border Grid.Row="2" BorderBrush="{DynamicResource ThemeDivider}" BorderThickness="0,1,0,0" Padding="24,0">
        <DockPanel LastChildFill="False">
          <TextBlock x:Name="BuildLabel" FontSize="11" Foreground="{DynamicResource ThemeMuted}"
                     VerticalAlignment="Center" />
          <Button Content="Done" MinWidth="80" FontWeight="SemiBold" DockPanel.Dock="Right"
                  Background="{DynamicResource ThemeSecondary}" VerticalAlignment="Center" Click="CloseNotes" />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
