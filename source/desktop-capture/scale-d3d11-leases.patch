+/* Keep the capture AVFrame leased until the queued video-processor read completes.
+ * This affects only the optional downscale stage, never the source queue protocol. */
+typedef struct FlickScaleLease {
+    AVFrame *input;
+    ID3D11Query *done;
+    ID3D11DeviceContext *context;
+} FlickScaleLease;
+
+static void flick_scale_release(void *opaque, uint8_t *data)
+{
+    FlickScaleLease *lease = (FlickScaleLease *)data;
+    HRESULT hr;
+    AVHWFramesContext *frames = (AVHWFramesContext *)lease->input->hw_frames_ctx->data;
+    AVD3D11VADeviceContext *hw = ((AVHWDeviceContext *)frames->device_ref->data)->hwctx;
+    /* GetData submits pending commands. Waiting happens in the worker, not the UI
+     * or acquisition thread; it prevents recycling a source texture still in use. */
+    do {
+        hw->lock(hw->lock_ctx);
+        hr = lease->context->lpVtbl->GetData(lease->context,
+            (ID3D11Asynchronous *)lease->done, NULL, 0, 0);
+        hw->unlock(hw->lock_ctx);
+        if (hr == S_FALSE) Sleep(1);
+    } while (hr == S_FALSE);
+    lease->done->lpVtbl->Release(lease->done);
+    lease->context->lpVtbl->Release(lease->context);
+    av_frame_free(&lease->input);
+    av_free(lease);
+}
 
